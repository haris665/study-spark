{
  "name": "study-spark-cloud-functions",
  "version": "1.0.0",
  "description": "Scheduled Firebase Cloud Functions for Study Spark daily reminder emails",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.4",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.0",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.7.3"
  },
  "private": true
}
